# === Django control plane ===================================================
DJANGO_SECRET_KEY=change-me-to-a-random-64-char-string
DJANGO_DEBUG=false
# Include the leading-dot wildcard so *.localhost subdomains are accepted too.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.localhost

REGISTRY_DB_NAME=tenant_registry
REGISTRY_DB_USER=registry_app_role
REGISTRY_DB_PASSWORD=change-me

PG_SUPERUSER_NAME=postgres
PG_SUPERUSER_PASSWORD=change-me

CREDENTIAL_ENCRYPTION_KEY=   # generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SIGNING_KEY=             # RSA private key PEM (see README for openssl commands)
JWT_VERIFYING_KEY=           # matching RSA public key PEM

# Use "localhost" for local dev so subdomains work as <tenant>.localhost:8000
# (Chrome/Firefox resolve *.localhost to 127.0.0.1 automatically — no
# /etc/hosts editing needed). Use your real domain (e.g. banking.com) in
# production.
PLATFORM_BASE_DOMAIN=localhost

# === Fineract =================================================================
# Assumes Fineract is already running as its own standalone container
# (`docker run --name fineract-server ... -p 8443:8443 apache/fineract`),
# NOT managed by this docker-compose file. Reached via host.docker.internal
# since it's published on the host, same as Django reaches host Postgres.
FINERACT_BASE_URL=https://host.docker.internal:8443/fineract-provider/api/v1
FINERACT_ADMIN_USERNAME=mifos
FINERACT_ADMIN_PASSWORD=change-me
